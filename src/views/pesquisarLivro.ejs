<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscar Livros</title>
    <link rel="stylesheet" href="/css/pesquisarLivro.css">
</head>

<body>

    <div class="container">
        <div class="card">

            <div class="logo-container">
                <img src="/img/logo.png" alt="Book College" class="logo">
            </div>

            <h2 class="titulo-busca">BUSCAR LIVROS:</h2>

            <div class="campo-busca">
                <input 
                    type="text" 
                    id="busca" 
                    name="busca" 
                    placeholder="Digite o título do livro..."
                    autocomplete="off"
                >
                <button class="btn-busca"></button>
            </div>

           <section class="lista-livro">

                <% if (livro.length> 0) { %>
                    <% livro.forEach(livro => { %>

                        <div class="linha-livro">
                            <div class="livro">
                                <span>
                                    <%= livro.titulo %>
                                </span>
                            </div>
                            <div class="acoes">
                                <a href="/livro/editar/<%= livro.id_livro %>" class="btn-acao">✏️</a>
                                <button onclick="deletarLivro(<%= livro.id_livro %>)" class="btn-acao">🗑️</button>
                            </div>
                            
                        </div>

                        <% }) %>
                            <% } else { %>
                                <p class="sem-resultados">Nenhum livro encontrado.</p>
                                <% } %>

            </section>

        </div>
    </div>

<script src="/frontDao/cadastroLivro.js"></script>
</body>
</html>