<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Editar Aluno</title>
    <link rel="stylesheet" href="/css/cadastro.css">
</head>
<body>
    <div class="container">

        <div class="logo">
            <img src="/img/logo.png" alt="Book College">
        </div>

        <div class="campo">
            <label>NOME:</label>
          
            <input type="text" id="nome" value="<%= aluno.nm_aluno %>" required>
        </div>

        <div class="campo">
            <label>MATRÍCULA:</label>
            <input type="text" id="matricula" value="<%= aluno.matricula %>" required>
        </div>

        <div class="campo">
            <label>CURSO:</label>
            <input type="text" id="curso" value="<%= aluno.curso %>" required>
        </div>

        <div class="campo">
            <label>TELEFONE:</label>
            <input type="text" id="telefone" value="<%= aluno.telefone %>" required>
        </div>

        <div class="btn-container">
            
            <button onclick="atualizarAluno(<%= aluno.id_aluno %>)">Atualizar Aluno</button>
        </div>

    </div>
</body>
<script src="/frontDao/cadastroAluno.js"></script>
</html>