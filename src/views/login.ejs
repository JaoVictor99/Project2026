<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <link rel="stylesheet" href="/css/telaLogin.css">
</head>
<body>

    <div class="logo"></div>
    <div class="container">

        <h2>Login</h2>
        <form id="login" action="/login" method="POST">

            <input
                type="text"
                name="identificador"
                placeholder="Digite seu ID"
                required
            >

            <input
                type="password"
                name="senha"
                placeholder="Digite sua senha"
                required
            >

            <button onclick="login">
                Entrar
            </button>
        </form>
    </div>
</body>
        <script src="/frontJS/login.js"></script>
</html>