<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <link rel="stylesheet" href="/css/telaLogin.css">
</head>
<body>

    <div class="logo"></div>
    <div class="container">

        <h2>Login</h2>
        <form id="login" method="POST">

            <input
                type="text"
                id="identificador"
                name="identificador"
                placeholder="Digite seu ID"
                required
            >

            <input
                type="password"
                id="senha"
                name="senha"
                placeholder="Digite sua senha"
                required
            >
        </form>

        <button onclick = "validarlogin()"  type="button">Entrar</button>
    </div>
</body>
        <script src="/frontDao/login.js"></script>
</html>