<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">
    <title>Login</title>
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <div class="container">

        <h2>Login</h2>

        <form action="/login" method="POST">

            <input
                type="text"
                name="id"
                placeholder="Digite seu ID"
                required
            >

            <input
                type="password"
                name="senha"
                placeholder="Digite sua senha"
                required
            >

            <button type="submit">
                Entrar
            </button>

        </form>

    </div>

</body>

</html>